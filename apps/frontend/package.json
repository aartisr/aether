{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "author": "Aarti Sri Ravikumar",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node ./scripts/clean-next-build.mjs && npm run rag:index",
    "build": "next build",
    "start": "next start",
    "rag:index": "node ./scripts/build-rag-index.mjs",
    "perf:smoke": "node ./scripts/perf-smoke.mjs",
    "perf:budget": "npm run build && npm run perf:smoke",
    "lint": "next lint",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "admin:rbac:validate": "node ./scripts/validate-admin-rbac-config.mjs",
    "workers:run:once": "node ./scripts/run-worker-queue.mjs",
    "test": "jest --config ../../jest.config.js --runInBand",
    "test:ci": "jest --config ../../jest.config.js --ci --coverage --runInBand"
  },
  "dependencies": {
    "@puckeditor/core": "^0.21.1",
    "@types/pg": "^8.20.0",
    "@vercel/analytics": "^2.0.1",
    "@xenova/transformers": "^2.17.2",
    "autoprefixer": "^10.4.27",
    "eslint-config-prettier": "^9.1.0",
    "next": "14.2.33",
    "pg": "^8.22.0",
    "posthog-js": "^1.415.6",
    "postcss": "^8.5.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.3.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.33",
    "typescript": "5.4.5"
  }
}
