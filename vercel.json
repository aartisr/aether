{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "NPM_CONFIG_USERCONFIG=.npmrc.public npm ci --include=dev --registry=https://registry.npmjs.org/ --always-auth=false --no-audit",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "crons": [
    {
      "path": "/api/peer-recruitment/workers/run?limit=25",
      "schedule": "*/10 * * * *"
    }
  ]
}
